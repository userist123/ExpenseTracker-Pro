<Window
    x:Class="ExpenseTrackerPro.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ExpenseTracker Pro"
    Width="1240"
    Height="800"
    MinWidth="960"
    MinHeight="640"
    Background="{StaticResource BackgroundBrush}"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title and month picker -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock
                    Text="ExpenseTracker Pro"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="{StaticResource TextBrush}" />
                <TextBlock
                    Text="Buget personal, offline și local"
                    Foreground="{StaticResource MutedBrush}" />
            </StackPanel>

            <DatePicker
                Grid.Column="1"
                Width="155"
                SelectedDate="{Binding SelectedDate}" />
        </Grid>

        <!-- Tagline -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock
                Text="Control clar asupra banilor tăi."
                FontSize="29"
                FontWeight="Bold"
                Foreground="{StaticResource TextBrush}" />
            <TextBlock
                Margin="0,6,0,0"
                Text="Tranzacțiile sunt salvate în SQLite, pe acest calculator."
                Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <!-- Monthly summary cards -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,16">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="VENITURI" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock
                        Text="{Binding Income, StringFormat={}{0:N2} RON}"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="CHELTUIELI" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock
                        Text="{Binding Expenses, StringFormat={}{0:N2} RON}"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{StaticResource DangerBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="SOLD LUNAR" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock
                        Text="{Binding Balance, StringFormat={}{0:N2} RON}"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="BUGET RĂMAS" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock
                        Text="{Binding RemainingBudget, StringFormat={}{0:N2} RON}"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextBrush}" />
                    <TextBlock
                        Text="{Binding MonthlyBudget, StringFormat=din {0:N2} RON}"
                        Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Main content: add form and transaction list -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Add transaction form -->
            <Border
                Grid.Column="0"
                Style="{StaticResource CardStyle}"
                VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock
                        Text="Adaugă tranzacție"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextBrush}" />

                    <TextBlock
                        Margin="0,18,0,6"
                        Text="Tip"
                        Foreground="{StaticResource MutedBrush}" />
                    <ComboBox
                        ItemsSource="{Binding TransactionTypes}"
                        DisplayMemberPath="DisplayName"
                        SelectedValuePath="Value"
                        SelectedValue="{Binding NewType}" />

                    <TextBlock
                        Margin="0,12,0,6"
                        Text="Categorie"
                        Foreground="{StaticResource MutedBrush}" />
                    <ComboBox
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding NewCategory}" />

                    <TextBlock
                        Margin="0,12,0,6"
                        Text="Descriere"
                        Foreground="{StaticResource MutedBrush}" />
                    <TextBox
                        Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="120" />

                    <TextBlock
                        Margin="0,12,0,6"
                        Text="Sumă (RON)"
                        Foreground="{StaticResource MutedBrush}" />
                    <TextBox Text="{Binding NewAmount, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Margin="0,12,0,6"
                        Text="Dată"
                        Foreground="{StaticResource MutedBrush}" />
                    <DatePicker SelectedDate="{Binding NewDate}" />

                    <Button
                        Margin="0,18,0,0"
                        Content="Salvează tranzacția"
                        Command="{Binding AddTransactionCommand}"
                        Background="{StaticResource AccentBrush}"
                        Foreground="#082019" />

                    <TextBlock
                        Margin="0,12,0,0"
                        Text="{Binding StatusMessage}"
                        Foreground="{StaticResource MutedBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Transaction list -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <DockPanel>
                    <StackPanel
                        DockPanel.Dock="Top"
                        Margin="0,0,0,12"
                        Orientation="Horizontal">
                        <TextBlock
                            Text="Tranzacții"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextBrush}"
                            VerticalAlignment="Center" />
                        <Button
                            Margin="16,0,0,0"
                            Content="Șterge selectată"
                            Command="{Binding DeleteTransactionCommand}" />
                        <Button
                            Margin="8,0,0,0"
                            Content="Export CSV"
                            Command="{Binding ExportCsvCommand}" />
                    </StackPanel>

                    <DataGrid
                        ItemsSource="{Binding Transactions}"
                        SelectedItem="{Binding SelectedTransaction}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Header="Data"
                                Width="120"
                                Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" />
                            <DataGridTextColumn
                                Header="Descriere"
                                Width="*"
                                Binding="{Binding Description}" />
                            <DataGridTextColumn
                                Header="Categorie"
                                Width="150"
                                Binding="{Binding Category}" />
                            <DataGridTextColumn
                                Header="Tip"
                                Width="110"
                                Binding="{Binding Type, Converter={StaticResource TransactionTypeDisplay}}" />
                            <DataGridTextColumn
                                Header="Sumă"
                                Width="140"
                                Binding="{Binding Amount, StringFormat={}{0:N2} RON}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

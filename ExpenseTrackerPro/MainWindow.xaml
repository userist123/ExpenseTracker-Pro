<Window x:Class="ExpenseTrackerPro.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ExpenseTrackerPro" Title="ExpenseTracker Pro" Height="860" Width="1340" MinHeight="700" MinWidth="1040" WindowStartupLocation="CenterScreen" Background="#08111F">
  <Window.DataContext><local:MainViewModel /></Window.DataContext>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ExpenseTracker Pro" FontSize="24" FontWeight="Bold" Foreground="#EFF7FF" /><TextBlock Text="Importă extrasul. Analizează local. Decizi informat." Foreground="#A4B6CB" /></StackPanel><DatePicker Grid.Column="1" SelectedDate="{Binding SelectedDate}" Width="155" /></Grid>
    <TabControl Grid.Row="1" Background="#10233A" Foreground="#EFF7FF">
      <TabItem Header="Dashboard"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20"><TextBlock Text="Control clar asupra banilor tăi." FontSize="28" FontWeight="Bold" /><UniformGrid Columns="4" Margin="0,18,0,16"><Border Background="#142B45" CornerRadius="12" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="VENITURI" Foreground="#A4B6CB" /><TextBlock Text="{Binding Income, StringFormat={}{0:N2} RON}" FontSize="22" FontWeight="Bold" Foreground="#57D9BE" /></StackPanel></Border><Border Background="#142B45" CornerRadius="12" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="CHELTUIELI" Foreground="#A4B6CB" /><TextBlock Text="{Binding Expenses, StringFormat={}{0:N2} RON}" FontSize="22" FontWeight="Bold" Foreground="#FF8797" /></StackPanel></Border><Border Background="#142B45" CornerRadius="12" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="SOLD LUNAR" Foreground="#A4B6CB" /><TextBlock Text="{Binding Balance, StringFormat={}{0:N2} RON}" FontSize="22" FontWeight="Bold" /></StackPanel></Border><Border Background="#142B45" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="BUGET RĂMAS" Foreground="#A4B6CB" /><TextBlock Text="{Binding RemainingBudget, StringFormat={}{0:N2} RON}" FontSize="22" FontWeight="Bold" /></StackPanel></Border></UniformGrid><TextBlock Text="{Binding DashboardSummary}" TextWrapping="Wrap" Foreground="#C6D6E7" FontSize="15" /></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Tranzacții"><Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="340" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="Adaugă tranzacție" FontSize="18" FontWeight="Bold" /><TextBlock Text="Tip" Margin="0,16,0,5" /><ComboBox ItemsSource="{Binding TransactionTypes}" SelectedItem="{Binding NewType}" /><TextBlock Text="Categorie" Margin="0,12,0,5" /><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding NewCategory}" /><TextBlock Text="Descriere" Margin="0,12,0,5" /><TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" /><TextBlock Text="Sumă (RON)" Margin="0,12,0,5" /><TextBox Text="{Binding NewAmount, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Text="Dată" Margin="0,12,0,5" /><DatePicker SelectedDate="{Binding NewDate}" /><Button Content="Salvează" Command="{Binding AddTransactionCommand}" Margin="0,16,0,0" /><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#A4B6CB" /></StackPanel><DockPanel Grid.Column="2"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10"><Button Content="Șterge selectata" Command="{Binding DeleteTransactionCommand}" /><Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Margin="8,0,0,0" /></StackPanel><DataGrid ItemsSource="{Binding Transactions}" SelectedItem="{Binding SelectedTransaction}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Data" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="120" /><DataGridTextColumn Header="Descriere" Binding="{Binding Description}" Width="*" /><DataGridTextColumn Header="Categorie" Binding="{Binding Category}" Width="150" /><DataGridTextColumn Header="Tip" Binding="{Binding Type}" Width="110" /><DataGridTextColumn Header="Sumă" Binding="{Binding Amount, StringFormat={}{0:N2} RON}" Width="140" /></DataGrid.Columns></DataGrid></DockPanel></Grid></TabItem>
      <TabItem Header="Import extras"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Import local de extras bancar" FontSize="20" FontWeight="Bold" /><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,16"><Button Content="Alege CSV sau XLSX" Command="{Binding ImportStatementCommand}" /><TextBlock Text="{Binding ImportStatus}" Margin="14,7,0,0" TextWrapping="Wrap" Foreground="#A4B6CB" /></StackPanel><DataGrid Grid.Row="2" ItemsSource="{Binding ImportPreview}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Data" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="120" /><DataGridTextColumn Header="Descriere" Binding="{Binding Description}" Width="*" /><DataGridTextColumn Header="Categorie sugerată" Binding="{Binding Category}" Width="160" /><DataGridTextColumn Header="Tip" Binding="{Binding Type}" Width="100" /><DataGridTextColumn Header="Sumă" Binding="{Binding Amount, StringFormat={}{0:N2} RON}" Width="140" /><DataGridTextColumn Header="Încredere" Binding="{Binding Confidence, StringFormat={}{0:P0}}" Width="100" /></DataGrid.Columns></DataGrid></Grid></TabItem>
      <TabItem Header="Analiză"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20"><TextBlock Text="Analiză lunară" FontSize="20" FontWeight="Bold" /><TextBlock Text="{Binding AnalysisHeadline}" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,8" TextWrapping="Wrap" /><TextBlock Text="{Binding AnalysisDetails}" Foreground="#C6D6E7" TextWrapping="Wrap" /><TextBlock Text="Recomandări" FontSize="18" FontWeight="Bold" Margin="0,22,0,8" /><ItemsControl ItemsSource="{Binding Insights}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#142B45" CornerRadius="10" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" /><TextBlock Text="{Binding Detail}" Foreground="#C6D6E7" TextWrapping="Wrap" Margin="0,5,0,0" /><TextBlock Text="{Binding PotentialSaving, StringFormat=Impact estimat: {0:N2} RON/lună}" Foreground="#57D9BE" Margin="0,6,0,0" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ItemsControl></StackPanel></ScrollViewer></TabItem>
    </TabControl>
  </Grid>
</Window>
